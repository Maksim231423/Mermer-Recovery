<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.StockManagement.StockActionsListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.StockManagement;assembly=Mermer.Ui.Core"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
    <DockPanel>
        <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
            <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
            <menu:CommonReload/>
            <menu:ListPrint x:Name="PrintButton" IsEnabled="{DXBinding '@e(GridControl).VisibleRowCount != 0'}"/>
            <menu:ListFilter x:Name="FilterButton"/>
            <menu:CommonClose/>
        </dxwui:AppBar>
        <ctrl:ListFilterControl DockPanel.Dock="Left"
                            Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
        <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>
        <dxlc:LayoutControl Margin="0" Orientation="Vertical">
            <dxlc:LayoutGroup Orientation="Vertical" Margin="10, 10, 10, 0">
                <dxlc:LayoutItem HorizontalAlignment="Left" Width="300" Label="{Localize Warehouse}">
                    <dxe:ComboBoxEdit DisplayMember="Name" 
                      ValueMember="Id"
                      ShowCustomItems="True"
                      NullText="{Localize 'All Warehouses'}"
                      EditValue="{Binding SelectedWarehouseIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Warehouses.List}"
                      IsTextEditable="False"
                      SeparatorString=", ">
                        <dxe:ComboBoxEdit.StyleSettings>
                            <dxe:CheckedComboBoxStyleSettings/>
                        </dxe:ComboBoxEdit.StyleSettings>
                    </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem HorizontalAlignment="Left" Width="730" Label="{Localize Stock}">
                    <ctrl:StockLookupEdit DataContext="{Binding StockSearcher}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem/>
                <dxlc:LayoutGroup VerticalAlignment="Top">
                    <Button Content="X" HorizontalAlignment="Left" Command="{Binding RemoveSelectedStockId}"
                  Visibility="{Binding StockIdSelected, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                    <Label VerticalContentAlignment="Center" MinHeight="24" Content="{Binding SelectedStockMessage}"/>
                </dxlc:LayoutGroup>
                <dxlc:LayoutItem HorizontalAlignment="Left" Width="300" Label="{Localize 'Balance Currency'}">
                    <dxe:ComboBoxEdit ShowCustomItems="True" DisplayMember="Name" ValueMember="Id"
                            EditValue="{Binding CurrencyId, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Currencies.List}"/>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dx:PLinqInstantFeedbackDataSource Name="ParalelLinqInstantSource" ItemsSource="{Binding List}"/>
            <ctrl:StyledGridControl x:Name="GridControl" FilterString="[TransactionIsCompleted] And ![TransactionIsDisabled]"
                              PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                              FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                              SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}"
                              ItemsSource="{Binding ElementName=ParalelLinqInstantSource, Path=Data}"
                              SelectedItem="{Binding SelectedItem, Converter={cnv:SafeLazyObjectConverter}}">
                <dxg:GridControl.Bands>
                    <dxg:GridControlBand Header="{Localize Transaction}">
                        <dxg:GridColumn FieldName="TransactionDate" SortOrder="Ascending" Header="{Localize Date}">
                            <dxg:ColumnBase.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="g"/>
                            </dxg:ColumnBase.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="TransactionCode" Header="{Localize Code}"/>
                        <dxg:GridColumn FieldName="TransactionType" Header="{Localize Type}">
                            <dxg:ColumnBase.EditSettings>
                                <dxg:LookUpEditSettings DisplayMember="Text" ValueMember="Value" ItemsSource="{Binding Types.List}"/>
                            </dxg:ColumnBase.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="TransactionUserName" Header="{Localize Author}"/>
                        <dxg:GridColumn FieldName="TransactionIsCompleted" Width="50" Visible="false" Header="{Localize Completed}"/>
                        <dxg:GridColumn FieldName="TransactionIsDisabled" Width="50" Visible="false" Header="{Localize Deleted}"/>
                        <dxg:GridColumn Visible="false" Binding="{Binding TransactionTags, Converter={cnv:TokenConverter}}"
                            Header="{Localize Tags}">
                            <dxg:ColumnBase.EditSettings>
                                <dxg:LookUpEditSettings>
                                    <dxe:BaseEditSettings.StyleSettings>
                                        <dxg:TokenLookUpEditStyleSettings/>
                                    </dxe:BaseEditSettings.StyleSettings>
                                </dxg:LookUpEditSettings>
                            </dxg:ColumnBase.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="TransactionGroup" Visible="false" Header="{Localize Group}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Stock}">
                        <dxg:GridColumn FieldName="StockCode" Header="{Localize Code}"/>
                        <dxg:GridColumn FieldName="StockName" Width="200" Header="{Localize Name}"/>
                        <dxg:GridColumn Visible="false" Binding="{Binding StockTags, Converter={cnv:TokenConverter}}"
                            Header="{Localize Tags}">
                            <dxg:ColumnBase.EditSettings>
                                <dxg:LookUpEditSettings>
                                    <dxe:BaseEditSettings.StyleSettings>
                                        <dxg:TokenLookUpEditStyleSettings/>
                                    </dxe:BaseEditSettings.StyleSettings>
                                </dxg:LookUpEditSettings>
                            </dxg:ColumnBase.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="StockGroup" Visible="false" Header="{Localize Group}"/>
                        <dxg:GridColumn FieldName="StockType" Visible="false" Header="{Localize Type}"/>
                        <dxg:GridColumn FieldName="RecommendedPrice" Width="80" Style="{StaticResource AmountDisplayFormat}"
                            Header="{Localize RecommendedPrice}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Action}">
                        <dxg:GridColumn FieldName="ActionWarehouseId" Header="{Localize Warehouse}">
                            <dxg:ColumnBase.EditSettings>
                                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Warehouses.List}"/>
                            </dxg:ColumnBase.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ActionRelatedObjectName" Header="{Localize 'Related Object'}"/>
                        <dxg:GridColumn FieldName="ActionIncome" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Income}"/>
                        <dxg:GridColumn FieldName="ActionExpense" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Expense}"/>
                        <dxg:GridColumn FieldName="ActionEffect" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Effect}"/>
                        <dxg:GridColumn FieldName="ActionPrice" Width="80" Style="{StaticResource AmountDisplayFormat}"
                            Header="{Localize Price}"/>
                        <dxg:GridColumn FieldName="GrandTotal" Width="80" Style="{StaticResource AmountDisplayFormat}"
                            Header="{Localize Total}"/>
                        <dxg:GridColumn FieldName="RecommendedTotal" Width="80" Style="{StaticResource AmountDisplayFormat}"
                            Header="{Localize RecommendedTotal}"/>
                        <dxg:GridColumn FieldName="GrandTotalInCustomCurrency" Width="100" Style="{StaticResource AmountDisplayFormat}"
                            Header="{Localize 'In Selected Currency'}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Additional}">
                        <dxg:GridColumn FieldName="TransactionIsCash" Width="50" Visible="true" Header="{Localize Cash}"/>
                        <dxg:GridColumn FieldName="IsCheaperThanRecommended" Width="50" Visible="true" Header="{Localize Cheap}"/>
                        <dxg:GridColumn FieldName="ActionOverhead" Width="80" Style="{StaticResource AmountDisplayFormat}"
                            Header="{Localize Overhead}"/>
                        <dxg:GridColumn FieldName="ActionDiscount" Width="80" Style="{StaticResource AmountDisplayFormat}"
                            Header="{Localize Discount}"/>
                    </dxg:GridControlBand>
                </dxg:GridControl.Bands>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem FieldName="TransactionDate" DisplayFormat="{}{0}" SummaryType="Count"/>
                    <dxg:GridSummaryItem FieldName="ActionIncome" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="ActionExpense" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="ActionEffect" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="GrandTotal" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="RecommendedTotal" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="ActionOverhead" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="ActionDiscount" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="GrandTotalInCustomCurrency" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                </dxg:GridControl.TotalSummary>
            </ctrl:StyledGridControl>
        </dxlc:LayoutControl>
    </DockPanel>
</mvx:MvxWpfView>