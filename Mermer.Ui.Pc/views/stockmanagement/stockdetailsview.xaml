<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.StockManagement.StockDetailsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.StockManagement;assembly=Mermer.Ui.Core"
                xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars">
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <dxwui:AppBarButton Alignment="Near" Label="{Localize 'Print BC'}" Command="{Binding PrintBarcodesCommand}"
                          Glyph="{dx:DXImageOffice2013 Image=Barcode_32x32.png}"/>
      <menu:DetailsSave/>
      <menu:DetailsSaveAndNew/>
      <menu:DetailsSaveAndClose/>
      <dxwui:AppBarSeparator Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
      <menu:CommonReload/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <Grid FocusManager.FocusedElement="{Binding ElementName=FirstFocus}">
      <dxlc:LayoutControl Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
        <dxlc:LayoutGroup Width="700" Orientation="Vertical" HorizontalAlignment="Left">
          <dxlc:LayoutGroup Padding="0,30,0,0">
            <dxlc:LayoutGroup Orientation="Vertical" Width="400">
              <dxlc:LayoutItem Label="{Localize Code}">
                <dxe:TextEdit EditValue="{Binding Details.Code, UpdateSourceTrigger=PropertyChanged}"
                              IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
              </dxlc:LayoutItem>
              <dxlc:LayoutItem Label="{Localize Name}">
                <dxe:ButtonEdit x:Name="FirstFocus" AllowDefaultButton="False"
                                EditValue="{Binding Details.Name, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}">
                  <dxe:ButtonInfo GlyphKind="Edit" Command="{Binding OpenNameComposer}"/>
                </dxe:ButtonEdit>
              </dxlc:LayoutItem>
              <dxlc:LayoutItem Label="{Localize ShortName}">
                <dxe:TextEdit EditValue="{Binding Details.ShortName, UpdateSourceTrigger=PropertyChanged}"
                              IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
              </dxlc:LayoutItem>
              <dxlc:LayoutItem Label="{Localize Unit}">
                <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox" IncrementalFiltering="True" ImmediatePopup="True"
                                  IsTextEditable="True" EditValue="{Binding Details.Unit, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                  ItemsSource="{Binding UnitNames}">
                  <dxe:BaseEdit.StyleSettings>
                    <dxe:ComboBoxStyleSettings/>
                  </dxe:BaseEdit.StyleSettings>
                </dxe:ComboBoxEdit>
              </dxlc:LayoutItem>
              <dxlc:LayoutItem Label="{Localize Price}">
                <dxlc:LayoutGroup>
                                    <dxe:SpinEdit MinValue="0" 
              MaskType="Numeric" 
              Mask="n2" 
              MaskUseAsDisplayFormat="True"
              EditValue="{Binding Details.Price, UpdateSourceTrigger=PropertyChanged}"
              IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
                                    <dxg:LookUpEdit DisplayMember="Name" ValueMember="Id" AutoPopulateColumns="false"
                                  EditValue="{Binding Details.CurrencyId, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                  ItemsSource="{Binding Currencies.List}">
                    <dxe:PopupBaseEdit.PopupContentTemplate>
                      <ControlTemplate>
                        <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                          <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Name" SortOrder="Ascending"/>
                          </dxg:GridControl.Columns>
                          <dxg:GridControl.View>
                            <dxg:TableView AutoWidth="true"/>
                          </dxg:GridControl.View>
                        </dxg:GridControl>
                      </ControlTemplate>
                    </dxe:PopupBaseEdit.PopupContentTemplate>
                    <dxe:ButtonEdit.Buttons>
                      <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding SelectCurrencyCommand}"/>
                    </dxe:ButtonEdit.Buttons>
                  </dxg:LookUpEdit>
                </dxlc:LayoutGroup>
              </dxlc:LayoutItem>
              <dxlc:LayoutItem Label="{Localize Barcodes}">
                <dxe:ComboBoxEdit AllowDefaultButton="False" VerticalContentAlignment="Top"
                                  EditValue="{Binding Details.Barcodes, Converter={cnv:TokenConverter}}"
                                  IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}">
                  <dxe:BaseEdit.StyleSettings>
                    <dxe:TokenComboBoxStyleSettings NewTokenPosition="Far"/>
                  </dxe:BaseEdit.StyleSettings>
                </dxe:ComboBoxEdit>
              </dxlc:LayoutItem>
              <dxlc:LayoutItem Label="{Localize Status}">
                <dxlc:LayoutGroup>
                  <dxe:CheckEdit Content="{Localize Deleted}"
                                 EditValue="{Binding Details.IsDisabled, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
                </dxlc:LayoutGroup>
              </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
          </dxlc:LayoutGroup>
          <dxlc:LayoutItem Height="20"/>
          <dxlc:LayoutGroup View="Tabs" Height="250">
            <dxlc:LayoutGroup Header="{Localize Additional}">
              <dxlc:LayoutGroup Orientation="Vertical" Width="400">
                <dxlc:LayoutItem Label="{Localize 'Balance Limit'}">
                  <dxlc:LayoutGroup>
                                        <dxe:SpinEdit MinValue="0" NullValueButtonPlacement="EditBox"
              MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"
              EditValue="{Binding Details.LimitMin, UpdateSourceTrigger=PropertyChanged}"
              NullText="{Localize Min}"/>
                                        <dxe:SpinEdit MinValue="0" NullValueButtonPlacement="EditBox"
              MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"
              EditValue="{Binding Details.LimitMax, UpdateSourceTrigger=PropertyChanged}"
              NullText="{Localize Max}"/>
                                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Height="10"/>
                <dxlc:LayoutItem Label="{Localize Type}">
                  <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox" IncrementalFiltering="True" ImmediatePopup="True"
                                    IsTextEditable="True" EditValue="{Binding Details.Type, UpdateSourceTrigger=PropertyChanged}"
                                    IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                    ItemsSource="{Binding TypeNames}">
                    <dxe:BaseEdit.StyleSettings>
                      <dxe:ComboBoxStyleSettings/>
                    </dxe:BaseEdit.StyleSettings>
                  </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="{Localize Group}">
                  <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox" IncrementalFiltering="True" ImmediatePopup="True"
                                    IsTextEditable="True" EditValue="{Binding Details.Group, UpdateSourceTrigger=PropertyChanged}"
                                    IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                    ItemsSource="{Binding GroupNames}">
                    <dxe:BaseEdit.StyleSettings>
                      <dxe:ComboBoxStyleSettings/>
                    </dxe:BaseEdit.StyleSettings>
                  </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="{Localize Tags}">
                  <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox" IncrementalFiltering="True" ImmediatePopup="True"
                                    IsTextEditable="True" EditValue="{Binding Details.Tags, Converter={cnv:TokenConverter}}"
                                    IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                    ItemsSource="{Binding TagNames}">
                    <dxe:BaseEdit.StyleSettings>
                      <dxe:TokenComboBoxStyleSettings NewTokenPosition="Far"/>
                    </dxe:BaseEdit.StyleSettings>
                  </dxe:ComboBoxEdit>
                </dxlc:LayoutItem>
              </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="{Localize Prices}">
              <dxg:GridControl ItemsSource="{Binding Details.Prices}" SelectedItem="{Binding SelectedPrice}">
                <dxg:GridControl.Columns>
                  <dxg:GridColumn FieldName="ValidFrom" Header="{Localize PriceValidFrom}"/>
                  <dxg:GridColumn FieldName="Price" Header="{Localize Price}">
                    <dxg:ColumnBase.EditSettings>
                      <dxe:SpinEditSettings MinValue="0"/>
                    </dxg:ColumnBase.EditSettings>
                  </dxg:GridColumn>
                  <dxg:GridColumn FieldName="CurrencyId">
                    <dxg:ColumnBase.EditSettings>
                      <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" AutoPopulateColumns="false"
                                              ItemsSource="{Binding Currencies.List}">
                        <dxe:PopupBaseEditSettings.PopupContentTemplate>
                          <ControlTemplate>
                            <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                              <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Name" SortOrder="Ascending"/>
                              </dxg:GridControl.Columns>
                              <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="true"/>
                              </dxg:GridControl.View>
                            </dxg:GridControl>
                          </ControlTemplate>
                        </dxe:PopupBaseEditSettings.PopupContentTemplate>
                        <dxe:ButtonEditSettings.Buttons>
                          <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding SelectPriceCurrencyCommand}"/>
                        </dxe:ButtonEditSettings.Buttons>
                      </dxg:LookUpEditSettings>
                    </dxg:ColumnBase.EditSettings>
                  </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                  <dxg:TableView NewItemRowPosition="Bottom" ShowGroupPanel="false" ShowSearchPanelMode="Never" AutoWidth="true"/>
                </dxg:GridControl.View>
              </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="{Localize 'Additional Prices'}">
              <dxg:GridControl AutoExpandAllGroups="true" ItemsSource="{Binding Details.AdditionalPrices}"
                               SelectedItem="{Binding SelectedAdditionalPrice}">
                <dxg:GridControl.Columns>
                  <dxg:GridColumn FieldName="Group" GroupIndex="0" Width="200" Header="{Localize Group}">
                    <dxg:ColumnBase.EditSettings>
                      <dxe:ComboBoxEditSettings IncrementalFiltering="True" ImmediatePopup="True" IsTextEditable="True"
                                                ItemsSource="{Binding PriceGroupNames}">
                        <dxe:ButtonEditSettings.Buttons>
                          <dxe:ButtonInfo GlyphKind="Minus" Command="{Binding RemoveSelectedAdditionalPriceCommand}"/>
                        </dxe:ButtonEditSettings.Buttons>
                        <dxe:BaseEditSettings.StyleSettings>
                          <dxe:ComboBoxStyleSettings/>
                        </dxe:BaseEditSettings.StyleSettings>
                      </dxe:ComboBoxEditSettings>
                    </dxg:ColumnBase.EditSettings>
                  </dxg:GridColumn>
                  <dxg:GridColumn FieldName="ValidFrom" Header="{Localize PriceValidFrom}"/>
                  <dxg:GridColumn FieldName="Price" Header="{Localize Price}">
                    <dxg:ColumnBase.EditSettings>
                      <dxe:SpinEditSettings MinValue="0"/>
                    </dxg:ColumnBase.EditSettings>
                  </dxg:GridColumn>
                  <dxg:GridColumn FieldName="CurrencyId">
                    <dxg:ColumnBase.EditSettings>
                      <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" AutoPopulateColumns="false"
                                              ItemsSource="{Binding Currencies.List}">
                        <dxe:PopupBaseEditSettings.PopupContentTemplate>
                          <ControlTemplate>
                            <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                              <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Name" SortOrder="Ascending"/>
                              </dxg:GridControl.Columns>
                              <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="true"/>
                              </dxg:GridControl.View>
                            </dxg:GridControl>
                          </ControlTemplate>
                        </dxe:PopupBaseEditSettings.PopupContentTemplate>
                        <dxe:ButtonEditSettings.Buttons>
                          <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding SelectAdditionalPriceCurrencyCommand}"/>
                        </dxe:ButtonEditSettings.Buttons>
                      </dxg:LookUpEditSettings>
                    </dxg:ColumnBase.EditSettings>
                  </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                  <dxg:TableView NewItemRowPosition="Bottom" ShowGroupPanel="false" ShowGroupedColumns="true"
                                 ShowSearchPanelMode="Never" AutoWidth="true"/>
                </dxg:GridControl.View>
              </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="{Localize Units}">
              <dxg:GridControl FilterString="![IsDefault]" ItemsSource="{Binding Details.Units}"
                               SelectedItem="{Binding SelectedUnit}">
                <dxg:GridControl.Columns>
                  <dxg:GridColumn FieldName="Name" Header="{Localize Name}"/>
                  <dxg:GridColumn FieldName="Multiplier" Header="{Localize Multiplier}">
                    <dxg:ColumnBase.EditSettings>
                      <dxe:SpinEditSettings MinValue="0"/>
                    </dxg:ColumnBase.EditSettings>
                  </dxg:GridColumn>
                  <dxg:GridColumn FieldName="Divider" Header="{Localize Divider}">
                    <dxg:ColumnBase.EditSettings>
                      <dxe:SpinEditSettings MinValue="0"/>
                    </dxg:ColumnBase.EditSettings>
                  </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                  <dxg:TableView NewItemRowPosition="Bottom" ShowGroupPanel="false" ShowSearchPanelMode="Never" AutoWidth="true"/>
                </dxg:GridControl.View>
              </dxg:GridControl>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="{Localize Description}">
              <dxe:TextEdit TextWrapping="Wrap" VerticalContentAlignment="Top" AcceptsReturn="true" AcceptsTab="true"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            EditValue="{Binding Details.Description, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
            </dxlc:LayoutGroup>
          </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
      </dxlc:LayoutControl>
      <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
        <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}"/>
      </Grid>
    </Grid>
  </DockPanel>
</mvx:MvxWpfView>