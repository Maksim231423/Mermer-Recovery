<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.StockManagement.StockBalancesByStatusesListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.StockManagement;assembly=Mermer.Ui.Core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
      <menu:CommonReload/>
      <menu:ListPrint x:Name="PrintButton" IsEnabled="{DXBinding '@e(GridControl).VisibleRowCount != 0'}"/>
      <menu:ListFilter x:Name="FilterButton"/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <ctrl:ListFilterTileControl DockPanel.Dock="Left"
                                Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>
    <dxlc:LayoutControl Margin="0" Orientation="Vertical">
      <dxlc:LayoutGroup Orientation="Horizontal" Margin="10, 10, 10, 0">
        <dxlc:LayoutItem HorizontalAlignment="Left" Width="300" Label="{Localize Warehouse}">
          <dxe:ComboBoxEdit ShowCustomItems="True" DisplayMember="Name" ValueMember="Id"
                            EditValue="{Binding SelectedWarehouseIds, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Warehouses.List}">
            <dxe:BaseEdit.StyleSettings>
              <dxe:CheckedComboBoxStyleSettings/>
            </dxe:BaseEdit.StyleSettings>
          </dxe:ComboBoxEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem HorizontalAlignment="Right" MinWidth="100">
          <dxg:LookUpEdit AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                          EditValue="{Binding DisplayCurrencyId, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Currencies.List}">
            <dxe:PopupBaseEdit.PopupContentTemplate>
              <ControlTemplate>
                <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                  <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Name"/>
                  </dxg:GridControl.Columns>
                  <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="true"/>
                  </dxg:GridControl.View>
                </dxg:GridControl>
              </ControlTemplate>
            </dxe:PopupBaseEdit.PopupContentTemplate>
          </dxg:LookUpEdit>
        </dxlc:LayoutItem>
      </dxlc:LayoutGroup>
      <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                              FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                              SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
        <dxg:GridControl.Bands>
                    <dxg:GridControlBand Header="{Localize Stock}">
                        <dxg:GridColumn FieldName="StockCode" SortOrder="Ascending" Header="{Localize Code}"/>
                        <dxg:GridColumn FieldName="StockName" SortOrder="Ascending" Width="300" Header="{Localize Name}"/>

                        <!-- Колонка с тегами через CellTemplate -->
                        <dxg:GridColumn FieldName="StockTags" Header="{Localize Tags}" Width="150">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RowData.Row.StockTags, Converter={cnv:TokenConverter}}"
                             VerticalAlignment="Center"
                             Margin="4,0"
                             TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- Колонки группировки -->
                        <dxg:GridColumn FieldName="StockGroup" GroupIndex="1" Header="{Localize Group}" AllowGrouping="True" ReadOnly="True"/>
<dxg:GridColumn FieldName="StockType" GroupIndex="0" Header="{Localize Type}" AllowGrouping="True" ReadOnly="True"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Balance}">
            <dxg:GridColumn FieldName="Income" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Income}"/>
            <dxg:GridColumn FieldName="Expense" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Expense}"/>
            <dxg:GridColumn FieldName="Balance" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Balance}"/>
            <dxg:GridColumn FieldName="StockUnit" Header="{Localize Unit}"/>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize Total}">
            <dxg:GridColumn FieldName="StockPrice" Style="{StaticResource QuantityDisplayFormat}" Header="{Localize Price}"/>
            <dxg:GridColumn FieldName="Total" Style="{StaticResource AmountDisplayFormat}" Header="{Localize Total}"/>
          </dxg:GridControlBand>
        </dxg:GridControl.Bands>
        <dxg:GridControl.TotalSummary>
          <dxg:GridSummaryItem FieldName="Total" SummaryType="Sum" DisplayFormat="#,##0.00"/>
        </dxg:GridControl.TotalSummary>
      </ctrl:StyledGridControl>
    </dxlc:LayoutControl>
  </DockPanel>
</mvx:MvxWpfView>