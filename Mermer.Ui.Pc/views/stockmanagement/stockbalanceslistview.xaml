<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.StockManagement.StockBalancesListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.StockManagement;assembly=Mermer.Ui.Core"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:helpers="clr-namespace:Mermer.Ui.Pc.Helpers"
                xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars">

    <!-- ДОДАНО: Ресурси вікна з нашим конвертером для ігнорування NotLoadedObject -->
    <mvx:MvxWpfView.Resources>
        <cnv:IgnoreNotLoadedConverter x:Key="IgnoreNotLoadedConverter"/>
    </mvx:MvxWpfView.Resources>

    <DockPanel>
        <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
            <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
            <menu:ShowActions/>
            <dxwui:AppBarSeparator/>
            <menu:CommonReload/>
            <menu:ListPrint x:Name="PrintButton" IsEnabled="{DXBinding '@e(GridControl).VisibleRowCount != 0'}"/>
            <menu:ListFilter x:Name="FilterButton"/>
            <menu:CommonClose/>
        </dxwui:AppBar>

        <ctrl:ListFilterControl DockPanel.Dock="Left"
                            Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>

        <dxlc:LayoutControl Margin="0" Orientation="Vertical">
            <dxlc:LayoutGroup Orientation="Vertical" Margin="10, 10, 10, 0">
                <dxlc:LayoutItem HorizontalAlignment="Left" Width="500" Label="{Localize Warehouse}">
                    <dxlc:LayoutGroup>
                        <!-- УБРАНО: ShowCustomItems="True" -->
                        <dxe:ComboBoxEdit DisplayMember="Name" ValueMember="Id"
                          IsTextEditable="False" SeparatorString=", " NullText="{Localize 'All Warehouses'}"
                          EditValue="{Binding SelectedWarehouseIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Warehouses.List}">
                            <dxe:ComboBoxEdit.StyleSettings>
                                <dxe:CheckedComboBoxStyleSettings/>
                            </dxe:ComboBoxEdit.StyleSettings>
                        </dxe:ComboBoxEdit>
                        <dxe:CheckEdit HorizontalAlignment="Right" Margin="10,0,0,0"
                       EditValue="{Binding AggregateWarehouses, UpdateSourceTrigger=PropertyChanged}"
                       Content="{Localize Aggregate}"/>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem HorizontalAlignment="Left" Width="730" Label="{Localize Stock}">
                    <ctrl:StockLookupEdit DataContext="{Binding StockSearcher}"/>
                </dxlc:LayoutItem>
                <dxlc:LayoutItem/>
                <dxlc:LayoutGroup VerticalAlignment="Top">
                    <Button Content="X" HorizontalAlignment="Left" Command="{Binding RemoveSelectedStockId}"
                  Visibility="{Binding StockIdSelected, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                    <Label VerticalContentAlignment="Center" MinHeight="24" Content="{Binding SelectedStockMessage}"/>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>

            

            <!-- ДОДАНО: SelectedItem з підключеним конвертером -->
            <ctrl:StyledGridControl x:Name="GridControl" 
                                    ItemsSource="{Binding List}"
                                    SelectedItem="{Binding SelectedItem, Converter={StaticResource IgnoreNotLoadedConverter}}"
                                    PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                                    FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                                    SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
                <dxg:GridControl.Bands>
                    <dxg:GridControlBand Header="{Localize Stock}">
                        <dxg:GridColumn FieldName="StockCode" ReadOnly="true" AllowEditing="False" AllowCellMerge="True"
                            Header="{Localize Code}"/>
                        <dxg:GridColumn FieldName="StockName" Width="600" ReadOnly="true" AllowEditing="False" AllowCellMerge="True"
                            Header="{Localize Name}"/>
                        <dxg:GridColumn FieldName="StockGroup" ReadOnly="true" AllowEditing="False" Visible="false"
                            Header="{Localize Group}"/>
                        <dxg:GridColumn FieldName="StockType" ReadOnly="true" AllowEditing="False" Visible="false" Header="{Localize Type}"/>
                        <dxg:GridColumn FieldName="WarehouseId" ReadOnly="true" AllowEditing="False" AllowCellMerge="True"
                            Header="{Localize Warehouse}"
                            Visible="{Binding AggregateWarehouses, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxg:ColumnBase.EditSettings>
                                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Warehouses.List}"/>
                            </dxg:ColumnBase.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Starting}">
                        <dxg:GridColumn FieldName="StartingBalance" Style="{StaticResource QuantityDisplayFormat}" Width="90"
                            Header="{Localize Balance}"/>
                        <dxg:GridColumn FieldName="StockUnit" Width="70" ReadOnly="true" AllowEditing="False" Header="{Localize Unit}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Income}">
                        <dxg:GridColumn FieldName="StockOpening" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Opening}"/>
                        <dxg:GridColumn FieldName="RevisionExceed" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Rev. Exc.'}"/>
                        <dxg:GridColumn FieldName="StockTransferDestination" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Transfer Destination'}"/>
                        <dxg:GridColumn FieldName="SalesReturn" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Sales Return'}"/>
                        <dxg:GridColumn FieldName="Purchase" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Purchase}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Expense}">
                        <dxg:GridColumn FieldName="StockSpoilage" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Spoilage}"/>
                        <dxg:GridColumn FieldName="StockUsage" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Usage}"/>
                        <dxg:GridColumn FieldName="RevisionDeficit" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Rev. Def.'}"/>
                        <dxg:GridColumn FieldName="StockTransferSource" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Transfer Source'}"/>
                        <dxg:GridColumn FieldName="Sales" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Sales}"/>
                        <dxg:GridColumn FieldName="PurchaseReturn" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Purchase Return'}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Resulting}">
                        <dxg:GridColumn FieldName="ResultingBalance" Style="{StaticResource QuantityDisplayFormat}" Width="90"
                            Header="{Localize Balance}"/>
                        <dxg:GridColumn FieldName="StockUnit" Width="70" ReadOnly="true" AllowEditing="False" Header="{Localize Unit}"/>
                    </dxg:GridControlBand>
                </dxg:GridControl.Bands>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem FieldName="StockCode" DisplayFormat="{}{0}" SummaryType="Count"/>
                    <dxg:GridSummaryItem FieldName="StartingBalance" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="StockOpening" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="RevisionExceed" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="StockTransferDestination" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="SalesReturn" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="Purchase" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="StockSpoilage" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="StockUsage" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="RevisionDeficit" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="StockTransferSource" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="Sales" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="PurchaseReturn" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                    <dxg:GridSummaryItem FieldName="ResultingBalance" DisplayFormat="#,##0.##" SummaryType="Sum"/>
                </dxg:GridControl.TotalSummary>
            </ctrl:StyledGridControl>
        </dxlc:LayoutControl>
    </DockPanel>
</mvx:MvxWpfView>