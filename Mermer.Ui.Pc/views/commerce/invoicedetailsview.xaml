<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.Commerce.InvoiceDetailsView"
                x:Name="RootView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:hlp="clr-namespace:Mermer.Ui.Pc.Helpers"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.Commerce;assembly=Mermer.Ui.Core"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                PreviewKeyDown="DetectShortCut">
    <DockPanel>
        <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
            <dxwui:AppBarButton HorizontalAlignment="Left" hlp:ShortcutExtender.Shortcut="Ctrl+E" Label="{Localize 'Edit Line'}"
                          Command="{Binding SelectedLineEditCommand}"
                          Visibility="{Binding IsLineSelected, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                          Glyph="{dx:DXImageGrayscale Image=Edit_32x32.png}"/>
            <dxwui:AppBarButton HorizontalAlignment="Left" hlp:ShortcutExtender.Shortcut="Ctrl+Delete"
                          Label="{Localize 'Delete Line'}" Command="{Binding SelectedLineDeleteCommand}"
                          Visibility="{Binding IsLineSelected, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                          Glyph="{dx:DXImageGrayscale Image=DeleteItem_32x32.png}"/>
            <dxwui:AppBarButton HorizontalAlignment="Left" Label="{Localize Alternatives}"
                          Command="{Binding SelectedLineAlternativeCommand}"
                          Visibility="{Binding IsLineSelected, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                          Glyph="{dx:DXImageGrayscale Image=Replace_32x32.png}"/>
            <dxwui:AppBarButton HorizontalAlignment="Center" hlp:ShortcutExtender.Shortcut="Ctrl+Home"
                          Label="{Localize 'Select Sales'}" Command="{Binding SelectSource}"
                          Visibility="{Binding CanSelectSource, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                          Glyph="{dx:DXImageGrayscale Image=ListNumbers_32x32.png}"/>
            <menu:CommonImport Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
            <dxwui:AppBarSeparator Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
            <dxwui:AppBarButton HorizontalAlignment="Center" hlp:ShortcutExtender.Shortcut="Ctrl+End" Label="{Localize Payments}"
                          Command="{Binding UpdatePaymentCommand}"
                          Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                          Glyph="{dx:DXImageGrayscale Image=Currency_32x32.png}"/>
            <dxwui:AppBarSeparator Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
            <menu:DetailsSave/>
            <menu:DetailsSaveAndNew/>
            <menu:DetailsSaveAndClose/>
            <dxwui:AppBarSeparator Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
            <menu:CommonReload/>
            <menu:DetailsPrint/>
            <menu:TransactionMoreOptions/>
            <menu:CopyCreate/>
            <dxwui:AppBarButton HorizontalAlignment="Right" hlp:ShortcutExtender.Shortcut="Ctrl+Q"
            Label="{Localize Close}"
            Click="CloseButton_Click"
            Focusable="False"
            Glyph="{dx:DXImageGrayscale Image=Close_32x32.png}"/>
        </dxwui:AppBar>
        <Grid>
            <dxlc:LayoutControl Margin="10,20,10,10" IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
                <dxlc:LayoutGroup Orientation="Vertical">
                    <dxlc:LayoutGroup View="Tabs" HorizontalAlignment="Stretch">
                        <dxlc:LayoutGroup.TabsStyle>
                            <Style TargetType="{x:Type dx:DXTabControl}">
                                <Setter Property="TabContentCacheMode" Value="CacheAllTabs"/>
                                    <Setter Property="dx:DXTabControl.View">
                                    <Setter.Value>
                                        <dx:TabControlMultiLineView HeaderLocation="Bottom"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </dxlc:LayoutGroup.TabsStyle>
                        <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize Lines}">
                            <dxlc:LayoutGroup>
                                <dxlc:LayoutItem MaxWidth="730" Label="{Localize Add}" IsEnabled="{Binding HasSaveAccess}">
                                    <dxlc:LayoutGroup>
                                        <ctrl:StockLookupEdit x:Name="FirstFocus" DataContext="{Binding StockSearcher}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:FocusBehavior EventName="Loaded"/>
                                            </dxmvvm:Interaction.Behaviors>
                                        </ctrl:StockLookupEdit>
                                        <dxe:SpinEdit MaxWidth="100" MinValue="0" EditValue="{Binding AddQuantity}"/>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem HorizontalAlignment="Right" MinWidth="100">
                                    <dxg:LookUpEdit AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                                  EditValue="{Binding Details.DisplayCurrencyId, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Currencies.List}">
                                        <dxe:PopupBaseEdit.PopupContentTemplate>
                                            <ControlTemplate>
                                                <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                    <dxg:GridControl.Columns>
                                                        <dxg:GridColumn FieldName="Name"/>
                                                    </dxg:GridControl.Columns>
                                                    <dxg:GridControl.View>
                                                        <dxg:TableView AutoWidth="true"/>
                                                    </dxg:GridControl.View>
                                                </dxg:GridControl>
                                            </ControlTemplate>
                                        </dxe:PopupBaseEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                            <dxg:GridControl x:Name="GridControl" ItemsSource="{Binding Details.Lines}" SelectedItem="{Binding SelectedLine}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand PassEventArgsToCommand="True" EventName="MouseDoubleClick"
                                         Command="{Binding SelectedLineEditCommand}"/>
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Bands>
                                    <dxg:GridControlBand Header="{Localize Stock}">
                                        <dxg:GridColumn Style="{StaticResource GridRowNo}"/>
                                        <dxg:GridColumn FieldName="StockId" AllowEditing="False" Width="100" Header="{Localize Code}">
                                            <dxg:ColumnBase.EditSettings>
                                                <dxe:ComboBoxEditSettings DisplayMember="Code" ValueMember="Id" ItemsSource="{Binding StocksCache}"/>
                                            </dxg:ColumnBase.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="StockId" AllowEditing="False" Width="700" Header="{Localize Name}">
                                            <dxg:ColumnBase.EditSettings>
                                                <dxe:ComboBoxEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding StocksCache}"/>
                                            </dxg:ColumnBase.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="{Localize Quantity}">
                                        <dxg:GridColumn FieldName="Quantity" Style="{StaticResource QuantityDisplayFormat}" Width="80"
                                    Header="{Localize Qnt}"/>
                                        <dxg:GridColumn FieldName="UnitId" Width="80" Header="{Localize Unit}">
                                            <dxg:ColumnBase.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:ComboBoxEdit Name="PART_Editor" IsTextEditable="False" DisplayMember="Name" ValueMember="Id">
                                                        <dxe:LookUpEditBase.ItemsSource>
                                                            <MultiBinding Converter="{cnv:StockUnitsFilterConverter}">
                                                                <Binding Path="RowData.Row.StockId"/>
                                                                <Binding Path="View.DataContext.StocksCache"/>
                                                                <Binding Path="IsEditorActive" RelativeSource="{RelativeSource Self}"/>
                                                            </MultiBinding>
                                                        </dxe:LookUpEditBase.ItemsSource>
                                                    </dxe:ComboBoxEdit>
                                                </DataTemplate>
                                            </dxg:ColumnBase.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="{Localize Price}">
                                        <dxg:GridColumn FieldName="Price" Style="{StaticResource AmountDisplayFormat}" Width="80" Header="{Localize Price}"/>
                                        <dxg:GridColumn FieldName="CurrencyId" Width="80" Header="{Localize Currency}">
                                            <dxg:ColumnBase.EditSettings>
                                                <dxg:LookUpEditSettings AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                                                ItemsSource="{Binding Currencies.List}">
                                                    <dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                        <ControlTemplate>
                                                            <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                                <dxg:GridControl.Columns>
                                                                    <dxg:GridColumn FieldName="Name"/>
                                                                </dxg:GridControl.Columns>
                                                                <dxg:GridControl.View>
                                                                    <dxg:TableView AutoWidth="true"/>
                                                                </dxg:GridControl.View>
                                                            </dxg:GridControl>
                                                        </ControlTemplate>
                                                    </dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                </dxg:LookUpEditSettings>
                                            </dxg:ColumnBase.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="{Localize Totals}">
                                        <dxg:GridColumn FieldName="DisplayTotal" ReadOnly="true" Width="100" Style="{StaticResource AmountDisplayFormat}"
                                    Header="{Localize Total}"/>
                                    </dxg:GridControlBand>
                                </dxg:GridControl.Bands>
                                <dxg:GridControl.View>
                                    <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="None"
                                 AllowEditing="{Binding HasSaveAccess}"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize 'Discounts &amp; Payments'}">
                            <dxlc:LayoutGroup Orientation="Vertical">
                                <dxlc:LayoutGroup>
                                    <dxlc:LayoutGroup View="Tabs">
                                        <dxlc:LayoutGroup Header="{Localize Payments}">
                                            <dxg:GridControl ItemsSource="{Binding Details.Payments}">
                                                <dxg:GridColumn FieldName="Amount" Style="{StaticResource AmountDisplayFormat}" Header="{Localize Amount}"/>
                                                <dxg:GridColumn FieldName="CurrencyId" Header="{Localize Currency}">
                                                    <dxg:ColumnBase.EditSettings>
                                                        <dxg:LookUpEditSettings AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                                                    ItemsSource="{Binding Currencies.List}">
                                                            <dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                                <ControlTemplate>
                                                                    <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                                        <dxg:GridControl.Columns>
                                                                            <dxg:GridColumn FieldName="Name"/>
                                                                        </dxg:GridControl.Columns>
                                                                        <dxg:GridControl.View>
                                                                            <dxg:TableView AutoWidth="true"/>
                                                                        </dxg:GridControl.View>
                                                                    </dxg:GridControl>
                                                                </ControlTemplate>
                                                            </dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                        </dxg:LookUpEditSettings>
                                                    </dxg:ColumnBase.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="Bottom"
                                         AllowEditing="{Binding HasSaveAccess}"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutGroup>
                                    <dxlc:LayoutGroup View="Tabs">
                                        <dxlc:LayoutGroup Header="{Localize Changes}">
                                            <dxg:GridControl ItemsSource="{Binding Details.Changes}">
                                                <dxg:GridColumn FieldName="Amount" Style="{StaticResource AmountDisplayFormat}" Header="{Localize Amount}"/>
                                                <dxg:GridColumn FieldName="CurrencyId" Header="{Localize Currency}">
                                                    <dxg:ColumnBase.EditSettings>
                                                        <dxg:LookUpEditSettings AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                                                    ItemsSource="{Binding Currencies.List}">
                                                            <dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                                <ControlTemplate>
                                                                    <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                                        <dxg:GridControl.Columns>
                                                                            <dxg:GridColumn FieldName="Name"/>
                                                                        </dxg:GridControl.Columns>
                                                                        <dxg:GridControl.View>
                                                                            <dxg:TableView AutoWidth="true"/>
                                                                        </dxg:GridControl.View>
                                                                    </dxg:GridControl>
                                                                </ControlTemplate>
                                                            </dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                        </dxg:LookUpEditSettings>
                                                    </dxg:ColumnBase.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="Bottom"
                                         AllowEditing="{Binding HasSaveAccess}"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup>
                                    <dxlc:LayoutGroup View="Tabs" MaxWidth="250">
                                        <dxlc:LayoutGroup Header="{Localize Discounts}">
                                            <dxg:GridControl ItemsSource="{Binding Details.Discounts}">
                                                <dxg:GridColumn FieldName="Type" Width="200" Header="{Localize Type}">
                                                    <dxg:ColumnBase.EditSettings>
                                                        <dxg:LookUpEditSettings AutoPopulateColumns="false" DisplayMember="Text" ValueMember="Value"
                                                    ItemsSource="{Binding DiscountTypes}">
                                                            <dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                                <ControlTemplate>
                                                                    <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                                        <dxg:GridControl.Columns>
                                                                            <dxg:GridColumn FieldName="Text"/>
                                                                        </dxg:GridControl.Columns>
                                                                        <dxg:GridControl.View>
                                                                            <dxg:TableView AutoWidth="true"/>
                                                                        </dxg:GridControl.View>
                                                                    </dxg:GridControl>
                                                                </ControlTemplate>
                                                            </dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                        </dxg:LookUpEditSettings>
                                                    </dxg:ColumnBase.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn FieldName="Amount" Header="{Localize Amount}">
                                                    <dxg:ColumnBase.EditSettings>
                                                        <dxe:TextEditSettings DisplayFormat="#,##0.00"/>
                                                    </dxg:ColumnBase.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="Bottom"
                                         AllowEditing="{Binding HasSaveAccess}"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutGroup>
                                    <dxlc:LayoutGroup View="Tabs">
                                        <dxlc:LayoutGroup Header="{Localize Overheads}">
                                            <dxg:GridControl ItemsSource="{Binding Details.Overheads}">
                                                <dxg:GridColumn FieldName="StockId" Width="250" Header="{Localize Stock}">
                                                    <dxg:ColumnBase.EditSettings>
                                                        <dxg:LookUpEditSettings NullValueButtonPlacement="EditBox" AutoPopulateColumns="false" DisplayMember="Fullname"
                                                    ValueMember="Id" ItemsSource="{Binding StocksCache}" NullText="{Localize 'General Expense'}">
                                                            <dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                                <ControlTemplate>
                                                                    <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                                        <dxg:GridControl.Columns>
                                                                            <dxg:GridColumn FieldName="Code"/>
                                                                            <dxg:GridColumn FieldName="Name" Width="200"/>
                                                                        </dxg:GridControl.Columns>
                                                                        <dxg:GridControl.View>
                                                                            <dxg:TableView AutoWidth="true"/>
                                                                        </dxg:GridControl.View>
                                                                    </dxg:GridControl>
                                                                </ControlTemplate>
                                                            </dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                            <dxe:BaseEditSettings.StyleSettings>
                                                                <dxg:SearchLookUpEditStyleSettings/>
                                                            </dxe:BaseEditSettings.StyleSettings>
                                                        </dxg:LookUpEditSettings>
                                                    </dxg:ColumnBase.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn FieldName="Description" Width="150" Header="{Localize Description}"/>
                                                <dxg:GridColumn FieldName="Amount" Style="{StaticResource AmountDisplayFormat}" Header="{Localize Amount}"/>
                                                <dxg:GridColumn FieldName="CurrencyId" Header="{Localize Currency}">
                                                    <dxg:ColumnBase.EditSettings>
                                                        <dxg:LookUpEditSettings AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                                                    ItemsSource="{Binding Currencies.List}">
                                                            <dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                                <ControlTemplate>
                                                                    <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                                        <dxg:GridControl.Columns>
                                                                            <dxg:GridColumn FieldName="Name"/>
                                                                        </dxg:GridControl.Columns>
                                                                        <dxg:GridControl.View>
                                                                            <dxg:TableView AutoWidth="true"/>
                                                                        </dxg:GridControl.View>
                                                                    </dxg:GridControl>
                                                                </ControlTemplate>
                                                            </dxe:PopupBaseEditSettings.PopupContentTemplate>
                                                        </dxg:LookUpEditSettings>
                                                    </dxg:ColumnBase.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="Bottom"
                                         AllowEditing="{Binding HasSaveAccess}"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Header="{Localize 'Unit Convertions'}">
                            <dxg:GridControl ItemsSource="{Binding Details.StockUnitConvertions}">
                                <dxg:GridControl.Bands>
                                    <dxg:GridControlBand Header="Stock">
                                        <dxg:GridColumn FieldName="StockId" AllowCellMerge="True" SortIndex="0" Header="{Localize Code}">
                                            <dxg:ColumnBase.EditSettings>
                                                <dxe:ComboBoxEditSettings DisplayMember="Code" ValueMember="Id" ItemsSource="{Binding StocksCache}"/>
                                            </dxg:ColumnBase.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="StockId" Width="700" AllowCellMerge="True" SortIndex="1" Header="{Localize Name}">
                                            <dxg:ColumnBase.EditSettings>
                                                <dxe:ComboBoxEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding StocksCache}"/>
                                            </dxg:ColumnBase.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="Unit Convertions">
                                        <dxg:GridColumn FieldName="UnitId" Header="{Localize Unit}">
                                            <dxg:ColumnBase.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:ComboBoxEdit Name="PART_Editor" IsTextEditable="False" DisplayMember="Name" ValueMember="Id">
                                                        <dxe:LookUpEditBase.ItemsSource>
                                                            <MultiBinding Converter="{cnv:StockUnitsFilterConverter}">
                                                                <Binding Path="RowData.Row.StockId"/>
                                                                <Binding Path="View.DataContext.StocksCache"/>
                                                                <Binding Path="IsEditorActive" RelativeSource="{RelativeSource Self}"/>
                                                            </MultiBinding>
                                                        </dxe:LookUpEditBase.ItemsSource>
                                                    </dxe:ComboBoxEdit>
                                                </DataTemplate>
                                            </dxg:ColumnBase.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Multiplier" Header="{Localize Multiplier}"/>
                                        <dxg:GridColumn FieldName="Divider" Header="{Localize Divider}"/>
                                    </dxg:GridControlBand>
                                </dxg:GridControl.Bands>
                                <dxg:GridControl.View>
                                    <dxg:TableView AutoWidth="true" AllowEditing="false" ShowGroupPanel="false" NewItemRowPosition="None"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Header="{Localize 'Currency Rates'}">
                            <dxg:GridControl ItemsSource="{Binding Details.CurrencyConvertions}">
                                <dxg:GridColumn FieldName="CurrencyId" Header="{Localize Currency}">
                                    <dxg:ColumnBase.EditSettings>
                                        <dxe:ComboBoxEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Currencies.List}"/>
                                    </dxg:ColumnBase.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Multiplier" Header="{Localize Multiplier}"/>
                                <dxg:GridColumn FieldName="Divider" Header="{Localize Divider}"/>
                                <dxg:GridControl.View>
                                    <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="None"
                                 AllowEditing="{Binding HasSaveAccess}"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Height="100">
                        <dxlc:LayoutGroup Background="#FF2F51A5">
                            <Border BorderBrush="#FFD6D6D6" BorderThickness="1" Padding="5">
                                <Grid>
                                    <TextBlock FontSize="100" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="6,-22,0,0" Opacity="0.1" Text="{Localize Totals}"/>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock FontSize="8" Margin="0,0,0,-6" Foreground="White" HorizontalAlignment="Left" FontWeight="Bold"
                               Text="{Localize 'LINES COUNT'}"/>
                                        <TextBlock FontSize="18" Foreground="White" HorizontalAlignment="Left"
                               Text="{Binding Details.LinesCount, FallbackValue=0}"/>
                                        <TextBlock FontSize="8" Margin="0,0,0,-6" Foreground="White" HorizontalAlignment="Left" FontWeight="Bold"
                               Text="{Localize 'QUANTITIES COUNT'}"/>
                                        <TextBlock FontSize="18" Foreground="White" HorizontalAlignment="Left"
                               Text="{Binding Details.LineQuantitiesSum, FallbackValue=0, Converter={cnv:DecimalToStringConverter Mask='#,##0.##'}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock FontSize="8" Margin="0,0,0,-4" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"
                               Text="{Localize 'SUB TOTAL'}"/>
                                        <TextBlock FontSize="16" Foreground="White" HorizontalAlignment="Right"
                               Text="{Binding Details.DisplayTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        <TextBlock FontSize="6" Margin="0,0,0,-4" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"
                               Text="{Localize DISCOUNTS}"/>
                                        <TextBlock FontSize="12" Foreground="White" HorizontalAlignment="Right"
                               Text="{Binding Details.DisplayDiscountsTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock FontSize="8" Margin="0,0,0,-6" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"
                               Text="{Localize 'GRAND TOTAL'}"/>
                                        <TextBlock FontSize="24" Foreground="White" HorizontalAlignment="Right"
                               Text="{Binding Details.DisplayGrandTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup>
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand PassEventArgsToCommand="False" EventName="MouseDown" Command="{Binding UpdatePaymentCommand}"/>
                            </dxmvvm:Interaction.Behaviors>
                            <FrameworkElement.Style>
                                <Style TargetType="{x:Type dxlc:LayoutGroup}">
                                    <Setter Property="Panel.Background" Value="#A52F2F"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Details.IsPayed}" Value="True"/>
                                                <Condition Binding="{Binding Details.IsDebitCredit}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Panel.Background" Value="#FF3E7038"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Details.IsPayed}" Value="True"/>
                                                <Condition Binding="{Binding Details.IsDebitCredit}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Panel.Background" Value="#FFCC6D00"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </FrameworkElement.Style>
                            <Border BorderBrush="#FFD6D6D6" BorderThickness="1" Padding="5">
                                <Grid>
                                    <TextBlock FontSize="100" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Margin="6,-22,0,0" Opacity="0.1" Text="{Localize Payments}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock FontSize="8" Margin="0,0,0,-10" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"
                               Text="{Localize PAYED}"/>
                                        <TextBlock FontSize="32" Foreground="White" HorizontalAlignment="Right"
                               Text="{Binding Details.DisplayPaymentsTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding Details.IsPayed, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=true}}">
                                            <TextBlock FontSize="8" Margin="0,0,0,-8" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"
                                 Text="{Localize LEFT}"/>
                                            <TextBlock FontSize="24" Foreground="White" HorizontalAlignment="Right"
                                 Text="{Binding Details.DisplayLeftTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock FontSize="8" Margin="0,0,0,-8" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"
                                 Text="{Localize CHANGE}"/>
                                            <TextBlock FontSize="24" Foreground="White" HorizontalAlignment="Right"
                                 Text="{Binding Details.DisplayChangesTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Background="#FF00859C"
                              Visibility="{Binding Details.CanDebitCredit, Converter={dxmvvm:BooleanToVisibilityConverter HiddenInsteadOfCollapsed=true}}">
                            <Border BorderBrush="#FFD6D6D6" BorderThickness="1" Padding="5">
                                <Grid>
                                    <TextBlock FontSize="100" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="6,-22,0,0" Opacity="0.1" Text="{Localize Balance}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <dxe:CheckEdit Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Content="{Localize 'Effect Balance'}"
                                   IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                   EditValue="{Binding Details.DebitCreditLeftAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Grid.Column="1" Grid.Row="0" Text="{Localize DEBIT}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Grid.Column="2" Grid.Row="0" Text="{Localize CREDIT}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1"
                               Text="{Localize BEFORE}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Grid.Column="1" Grid.Row="1"
                               Text="{Binding PartnerBalanceToDate.Debit, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Grid.Column="2" Grid.Row="1"
                               Text="{Binding PartnerBalanceToDate.Credit, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Grid.Column="0"
                               Grid.Row="2" Text="{Localize EFFECT}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Grid.Column="1" Grid.Row="2"
                               Text="{Binding Details.DisplayDebitTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Grid.Column="2" Grid.Row="2"
                               Text="{Binding Details.DisplayCreditTotal, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Grid.Column="0" Grid.Row="3"
                               Text="{Localize RESULTING}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Grid.Column="1" Grid.Row="3"
                               Text="{Binding PartnerBalanceResult.Debit, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                        <TextBlock FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Grid.Column="2" Grid.Row="3"
                               Text="{Binding PartnerBalanceResult.Credit, FallbackValue=0.00, Converter={cnv:DecimalToStringConverter}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Vertical" HorizontalAlignment="Right" Width="400">
                    <dxlc:LayoutGroup View="Tabs">
                        <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize Details}">
                            <dxlc:LayoutItem Label="{Localize Code}">
                                <dxe:TextEdit EditValue="{Binding Details.Code, UpdateSourceTrigger=PropertyChanged}"
                              IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize Date}">
                                <dxe:DateEdit Mask="f" MaskUseAsDisplayFormat="true"
                              EditValue="{Binding Details.Date, UpdateSourceTrigger=PropertyChanged}"
                              IsReadOnly="{Binding CanChangeDate, Converter={dxmvvm:BooleanNegationConverter}}"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize 'Due Date'}">
                                <dxe:DateEdit Mask="D" MaskUseAsDisplayFormat="true"
                              EditValue="{Binding Details.DueDate, UpdateSourceTrigger=PropertyChanged}"
                              IsReadOnly="{Binding CanChangeDate, Converter={dxmvvm:BooleanNegationConverter}}"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Height="10"/>
                            <dxlc:LayoutItem Label="{Localize Partner}">
                                <dxg:LookUpEdit x:Name="PartnerEditor" DisplayMember="Fullname" ValueMember="Id" AutoPopulateColumns="false"
                                EditValue="{Binding Details.PartnerId, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                ItemsSource="{Binding Partners.List}" AllowDefaultButton="{Binding HasSaveAccess}">
                                    <dxe:PopupBaseEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="Code" Header="{Localize Code}"/>
                                                    <dxg:GridColumn FieldName="Name" Width="300" Header="{Localize Name}"/>
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxe:PopupBaseEdit.PopupContentTemplate>
                                    <dxg:LookUpEdit.StyleSettings>
                                        <dxg:SearchLookUpEditStyleSettings/>
                                    </dxg:LookUpEdit.StyleSettings>
                                    <dxe:ButtonInfo GlyphKind="Cancel" Command="{Binding RemovePartnerCommand}"
                                  Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                    <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding SelectPartnerCommand}"
                                  Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize Office}">
                                <dxg:LookUpEdit DisplayMember="Name" ValueMember="Id" AutoPopulateColumns="false"
                                EditValue="{Binding Details.OfficeId, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                ItemsSource="{Binding Offices.List}" AllowDefaultButton="{Binding HasSaveAccess}">
                                    <dxe:PopupBaseEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="Name"/>
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxe:PopupBaseEdit.PopupContentTemplate>
                                    <dxg:LookUpEdit.StyleSettings>
                                        <dxg:SearchLookUpEditStyleSettings/>
                                    </dxg:LookUpEdit.StyleSettings>
                                    <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding SelectOfficeCommand}"
                                  Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize Warehouse}">
                                <dxg:LookUpEdit DisplayMember="Name" ValueMember="Id" AutoPopulateColumns="false"
                                EditValue="{Binding Details.WarehouseId, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                ItemsSource="{Binding Warehouses.List}" AllowDefaultButton="{Binding HasSaveAccess}">
                                    <dxe:PopupBaseEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="Name"/>
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxe:PopupBaseEdit.PopupContentTemplate>
                                    <dxg:LookUpEdit.StyleSettings>
                                        <dxg:SearchLookUpEditStyleSettings/>
                                    </dxg:LookUpEdit.StyleSettings>
                                    <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding SelectWarehouseCommand}"
                                  Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize Depository}">
                                <dxg:LookUpEdit DisplayMember="Name" ValueMember="Id" AutoPopulateColumns="false"
                                EditValue="{Binding Details.DepositoryId, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                ItemsSource="{Binding Depositories.List}" AllowDefaultButton="{Binding HasSaveAccess}">
                                    <dxe:PopupBaseEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="Name"/>
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="true"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxe:PopupBaseEdit.PopupContentTemplate>
                                    <dxg:LookUpEdit.StyleSettings>
                                        <dxg:SearchLookUpEditStyleSettings/>
                                    </dxg:LookUpEdit.StyleSettings>
                                    <dxe:ButtonInfo GlyphKind="Regular" Command="{Binding SelectDepositoryCommand}"
                                  Visibility="{Binding HasSaveAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                </dxg:LookUpEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Height="10"/>
                            <dxlc:LayoutItem Label="{Localize Type}">
                                <dxe:ComboBoxEdit DisplayMember="Text" ValueMember="Value"
                                  EditValue="{Binding Details.InvoiceType, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="{Binding CanChangeType, Converter={dxmvvm:BooleanNegationConverter}}"
                                  AllowDefaultButton="{Binding CanChangeType}" ItemsSource="{Binding Types}"/>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize Status}">
                                <dxlc:LayoutGroup>
                                    <dxe:CheckEdit Content="{Localize Completed}"
                                 EditValue="{Binding Details.IsCompleted, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
                                    <dxe:CheckEdit Content="{Localize Deleted}"
                                 EditValue="{Binding Details.IsDisabled, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutItem Height="10"/>
                    <dxlc:LayoutGroup View="Tabs">
                        <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize Additional}">
                            <dxlc:LayoutItem Label="{Localize Group}">
                                <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox" IncrementalFiltering="True" ImmediatePopup="True"
                                  IsTextEditable="True" EditValue="{Binding Details.Group, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                  ItemsSource="{Binding GroupNames}">
                                    <dxe:BaseEdit.StyleSettings>
                                        <dxe:ComboBoxStyleSettings/>
                                    </dxe:BaseEdit.StyleSettings>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize Tags}" Visibility="Collapsed">
                                <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox" IncrementalFiltering="True" ImmediatePopup="True"
                      IsTextEditable="True" EditValue="{Binding Details.Tags, Converter={cnv:TokenConverter}}"
                      IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                      ItemsSource="{Binding TagNames}">
                                    <dxe:BaseEdit.StyleSettings>
                                        <dxe:TokenComboBoxStyleSettings NewTokenPosition="Far"/>
                                    </dxe:BaseEdit.StyleSettings>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="{Localize 'Price Group'}">
                                <dxe:ComboBoxEdit NullValueButtonPlacement="EditBox" IncrementalFiltering="True" ImmediatePopup="True"
                                  EditValue="{Binding Details.StockPriceGroup, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"
                                  ItemsSource="{Binding PriceGroupNames}">
                                    <dxe:BaseEdit.StyleSettings>
                                        <dxe:ComboBoxStyleSettings/>
                                    </dxe:BaseEdit.StyleSettings>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize Description}">
                            <dxlc:LayoutItem Label="{Localize Author}">
                                <dxe:TextEdit IsReadOnly="true" EditValue="{Binding Details.UserName, UpdateSourceTrigger=PropertyChanged}"/>
                            </dxlc:LayoutItem>
                            <dxe:TextEdit TextWrapping="Wrap" VerticalContentAlignment="Top" AcceptsReturn="true" AcceptsTab="true"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            EditValue="{Binding Details.Description, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding HasSaveAccess, Converter={dxmvvm:BooleanNegationConverter}}"/>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Header="{Localize Logs}"/>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutControl>
            <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
                <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </DockPanel>
</mvx:MvxWpfView>